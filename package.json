{
  "name": "personal-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "个人博客：本地 Markdown 写作、静态生成、自动校验",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0"
  },
  "devDependencies": {
    "lighthouse": "^13.6.0",
    "playwright": "^1.64.1"
  }
}
